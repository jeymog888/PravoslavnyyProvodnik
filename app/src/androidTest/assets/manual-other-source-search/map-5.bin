var objMap, objectManager, buttons=[], ortoxPolygon, showArea=false, aArea=[], areaCollection, buttonFS, data_bounds, v_noAutoBounds=true, myClusterer;
jQuery(document).ready(
	function(){
		jQuery("#box-filters #preloader-mapfilter").hide();
		jQuery('#box-filters #country').change( function(){ selCountry()} );
	 	// jQuery('#box-filters #btn-search').click(function() {	searchChurch(); });
	 	// jQuery('#box-filters #church_search').keypress(function(e){ if(e.which == 13)  searchChurch(); });  
	 	jQuery('#box-filters #btn-search-clear').click(function() {	clearFilters();	});
	 	jQuery('#f_search').keypress(function(e){ if(e.which == 13)  getDataFilters(); });  
	}
);

function init_map(mapID) {
	ymaps.ready( function(){

		if ( geoLoc ) {

	    ymaps.geolocation.get().then(
	    	function (res) {
					var geoObject = res.geoObjects.get(0);
					// mapOptions = geoObject && { bounds: geoObject.properties.get('boundedBy') };
					if (geoObject) defaultMapOptions.center=geoObject.geometry.getCoordinates();
					// mapOptions = geoObject && { center: , zoom: defaultMapOptions.zoom };
					// mapOptions.controls = [];
	        createMap(defaultMapOptions);
		    }, function () {
					createMap(defaultMapOptions);
		    }
	    );

	  } else {
			createMap(defaultMapOptions);
	  } 

		function createMap(options) {
		  window.objMap = new ymaps.Map(mapID, options, { minZoom: 3, restrictMapArea: [[-85,-179.9],[85,179.9]] });
			setMapOptions();
		}

	});
}

function setMapOptions() {
	// BalloonContentLayout
	var customBalloonContentLayout = ymaps.templateLayoutFactory.createClass([
      '<div class="balloon-content"><ul class="marker-list">',
      '{% for geoObject in properties.geoObjects %}',
          '<li class="item"><a href="javascript:void(0)" data-placemarkid="{{ geoObject.properties.infoId }}" class="list_item"><img src="{{geoObject.properties.iconURL}}"> {{ geoObject.properties.hintContent|raw }}</a></li>',
          '<li class="item-info" style="display:none"><div class="marker-info" id="marker-info-{{ geoObject.properties.infoId }}"></div></li>',
      '{% endfor %}',
      '</ul></div>'
    ].join('')
  );

	objMap.events.add( 'click', function (e) { if (objMap.balloon.isOpen()) {objMap.balloon.close();	jQuery('#box-list li a').removeClass('is_sel');} } );

	jQuery(document).on( "click", "div.balloon-content a.list_item", function() {
