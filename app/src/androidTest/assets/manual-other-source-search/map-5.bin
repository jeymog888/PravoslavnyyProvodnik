		}
	});
}

function setDataBounds() {
	var p_bounds = objMap.getBounds();
	var z=objMap.getZoom();
// console.log(JSON.stringify(p_bounds));
// console.log(z);
	var p_delta=12/z;
	var d_lat=(p_bounds[1][0]-p_bounds[0][0])/p_delta;
	if ( p_bounds[1][1]>p_bounds[0][1] )
		var d_lon=(p_bounds[1][1]-p_bounds[0][1])/p_delta;
	else 
		var d_lon=((180+(180+p_bounds[1][1]))-p_bounds[0][1])/p_delta;
	var lat0 = getRoundCoord(p_bounds[0][0]-d_lat, 'lat',0);
	var lon0 = getRoundCoord(p_bounds[0][1]-d_lon, 'lon',0);
	var lat1 = getRoundCoord(p_bounds[1][0]+d_lat, 'lat',0);
	var lon1 = getRoundCoord(p_bounds[1][1]+d_lon, 'lon',0);
	data_bounds = [[lat0,lon0],[lat1,lon1]];
// console.log(JSON.stringify(data_bounds));
	return true;
}

function getRoundCoord(coord,pmode,pround) {
	switch ( pround ) {
		case 0:
			var newCoord = Math.round(coord*100000)/100000;
	  	break;
		case 1:
			// var newCoord = (coord<0 ? Math.floor(Math.abs(coord*2)/10):Math.ceil(Math.abs(coord*2)/10))*10*(coord<0 ? -1:1)/2;
			var newCoord = (coord<0 ? Math.floor(Math.abs(coord)):Math.ceil(Math.abs(coord)))*(coord<0 ? -1:1);
	  	break;
		case 2:
			// var newCoord = (coord<0 ? Math.ceil(Math.abs(coord*2)/10):Math.floor(Math.abs(coord*2)/10))*10*(coord<0 ? -1:1)/2;
			var newCoord = (coord<0 ? Math.ceil(Math.abs(coord)):Math.floor(Math.abs(coord)))*(coord<0 ? -1:1);
	  	break;
  }
	var coordLimit=0;
	switch ( pmode ) {
		case 'lat':
			coordLimit=85;
			newCoord=(newCoord>coordLimit ? coordLimit : ( newCoord<-coordLimit ? -coordLimit : newCoord ) );
	  	break;
		case 'lon':
			coordLimit=180;
			newCoord=(newCoord>coordLimit ? (-coordLimit + (newCoord-coordLimit) ) : ( newCoord<-coordLimit ? (coordLimit-(newCoord+coordLimit)) : newCoord ) );
	  	break;
  }
	return newCoord;
}

function checkMapBounds() {
	if (v_noAutoBounds) {
		if (data_bounds==undefined) return false;
		var p_bounds = objMap.getBounds();
		var rectangle = new ymaps.geometry.base.Rectangle(data_bounds);
		if ( rectangle.contains(p_bounds[0]) && rectangle.contains(p_bounds[1]) )
			return true;
		else
			return false;
	}	else
		return true;
}

function getAreaEparchy(id) {
// if (id==6660) id=11701;
	if ( aArea[id] ) {
		// show_area( aArea[id] );
		return true;
	} 
	var p_mode='token=c2cbe8cd873f8e4751a7f7bb5292e68a&m=area&id='+id;
	jQuery.ajax({
		type: "GET", url: "/api/index.php", data: p_mode, dataType: "json",	cache: false,
		success: function (data) {
			if (data != "ERROR") {
				// aArea[id] = data;
				show_area(id,data);
			}
		}
	});
}


var fillopacity_polygon = 0.3, opacity_line=0.9, width_line = 2;
function show_area(id,data) {
	if (data.area && data.area.coords.length>0) {
		var color_polygon = data.area.color_polygon;
		var color_line = data.area.color_line;
		aArea[id]=true;

		var Polygon = new ymaps.Polygon(jQuery.parseJSON(data.area.coords), 
			{hintContent: data.area_name, },
			{
		    editorDrawingCursor: "crosshair",
				fillColor: color_polygon,
				strokeColor: color_line,
				opacity: fillopacity_polygon,
				strokeOpacity: opacity_line,
				strokeWidth: width_line
			}
		);
		//areaCollection.add(Polygon);
		// objMap.geoObjects.add(areaCollection);       
		objMap.geoObjects.add(Polygon);
		Polygon=false;
	}
}

function setAreaMode() {
	var chk = jQuery('#area_e:checkbox').filter(":checked").val();
	if (chk!=undefined) {
		showArea=true;
		// areaCollection = new ymaps.GeoObjectCollection();
		if (v_noAutoBounds) {
			var z=objMap.getZoom();
			if  (z>=zoomFilter) {
				objMap.setZoom(zoomFilter-1);
			} else {
				setBoxList();
			}
		} else {
			setBoxList();
		}
	}	else {
		showArea=false;
		aArea=[];
		// objMap.geoObjects.remove(areaCollection);  
		//areaCollection.removeAll();
		window.objMap.geoObjects.removeAll();
		window.objMap.geoObjects.add(window.objectManager);
		getDataFilters();
	}
}

function get_info(infoId,clusterBalloon) {
	if ( infoId==undefined ) return true;
	jQuery('#box-list li a').removeClass('is_sel');
	jQuery('#box-list #i'+infoId).addClass('is_sel');

	var loadText='<div id="preloader"><img src="/images/preloader.gif" alt="AJAX loader" title="AJAX loader"/> Идет загрузка ...</div>';
	if (clusterBalloon) {
		var objDiv = jQuery("#marker-info-"+infoId)[0];
		if ( jQuery(objDiv).html() ) {
			showBalloonContent(infoId);
			return true;
		} 
	} else {
	  var obj = objectManager.objects.getById(infoId);
	  obj.properties.balloonContent = loadText;
	  objectManager.objects.balloon.open(infoId);
	}

	if (url_mode && url_mode==undefined) url_mode=0;

	var p_mode='token=c2cbe8cd873f8e4751a7f7bb5292e68a&m=info&msg=1&id='+infoId+'&urlmode='+url_mode+'&lang=ru';
	jQuery.ajax({
		type: "GET", url: "/api/index.php", data: p_mode, dataType: "html",	cache: false,
		success: function (data) {
			if (data != "ERROR") {
				if (clusterBalloon) {
					jQuery(objDiv).html(data);
					showBalloonContent(infoId);
			  } else {
				  obj.properties.balloonContent = data;
			  	objectManager.objects.balloon.open(infoId);
			  }
			}
		}
	});
}

function showBalloonContent(infoId) {
	jQuery("li.item-info").hide();
	jQuery("li.item").show();
	jQuery("#marker-info-"+infoId).parent().prev().filter('li.item').hide();
	jQuery("#marker-info-"+infoId).parent().show();
	return true;
}

