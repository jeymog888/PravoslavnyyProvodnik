b6%d0%b5%d0%bd%d0%b8%d0%b9-%d0%b2-%d1%84%d0%b5%d0%b2%d1%80%d0%b0%d0%bb%d0%b5-2026-%d0%b3.html","title":{"rendered":"\u0420\u0430\u0441\u043f\u0438\u0441\u0430\u043d\u0438\u0435 \u0431\u043e\u0433\u043e\u0441\u043b\u0443\u0436\u0435\u043d\u0438\u0439 \u0432 \u0444\u0435\u0432\u0440\u0430\u043b\u0435 2026 \u0433\u043e\u0434\u0430"},"excerpt":{"rendered":"<p>\u0421\u0431. 31 \u0421\u0432\u0442\u0442. \u0410\u0444\u0430\u043d\u0430\u0441\u0438\u044f (373) \u0438 \u041a\u0438\u0440\u0438\u043b\u043b\u0430 (444), \u0430\u0440\u0445\u0438\u0435\u043f\u0438\u0441\u043a\u043e\u043f\u043e\u0432 \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0438\u0439\u0441\u043a\u0438\u0445. \u041f\u0440\u043f\u043f. \u0441\u0445\u0438\u043c\u043e\u043d\u0430\u0445\u0430 \u041a\u0438\u0440\u0438\u043b\u043b\u0430 \u0438 \u0441\u0445\u0438\u043c\u043e\u043d\u0430\u0445\u0438\u043d\u0438 \u041c\u0430\u0440\u0438\u0438 (\u043e\u043a. 1337), \u0440\u043e\u0434\u0438\u0442\u0435\u043b\u0435\u0439 \u043f\u0440\u043f. \u0421\u0435\u0440\u0433\u0438\u044f \u0420\u0430\u0434\u043e\u043d\u0435\u0436\u0441\u043a\u043e\u0433\u043e. 9-00 \u041c\u043e\u043b\u0435\u0431\u0435\u043d 16-00&#8230;<\/p>\n","protected":false}}]