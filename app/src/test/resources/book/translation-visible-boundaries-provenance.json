      "splits": [
        {
          "oldId": "liturgy-af63642abcec-1:6bfea96e4df0c5da:1",
          "chapterId": "liturgy-af63642abcec-1",
          "prefix": "И священник возглашает:",
          "rubricId": "liturgy-af63642abcec-1:d9746527e51c57a7:1",
          "prayerId": "liturgy-af63642abcec-1:c0e14e57a7e8e129:1",
          "prayer": "Я́ко подоба́ет Тебе́ вся́кая сла́ва, честь и поклоне́ние, Отцу́, и Сы́ну, и Свято́му Ду́ху, ны́не и при́сно, и во ве́ки веко́в.",
          "isAltarText": false
        },
        {
          "oldId": "liturgy-ed716e9f74f9-1:00a89f4488a8e4fe:1",
          "chapterId": "liturgy-ed716e9f74f9-1",
          "prefix": "И священник возглашает:",
          "rubricId": "liturgy-ed716e9f74f9-1:d9746527e51c57a7:1",
          "prayerId": "liturgy-ed716e9f74f9-1:9740e8717922cffa:1",
          "prayer": "Я́ко Твоя́ держа́ва, и Твое́ есть Ца́рство и си́ла и сла́ва, Отца́ и Сы́на и Свята́го Ду́ха, ны́не и при́сно и во ве́ки веко́в.",
          "isAltarText": false
        },
        {
          "oldId": "liturgy-ed716e9f74f9-2:0eecffd339f17734:1",
          "chapterId": "liturgy-ed716e9f74f9-2",
          "prefix": "И священник возглашает:",
          "rubricId": "liturgy-ed716e9f74f9-2:d9746527e51c57a7:1",
          "prayerId": "liturgy-ed716e9f74f9-2:17e5c146d4ccb252:1",
          "prayer": "Я́ко благ и человеколю́бец Бог еси́, и Тебе́ сла́ву возсыла́ем, Отцу́, и Сы́ну, и Свято́му Ду́ху, ны́не и при́сно, и во ве́ки веко́в.",
          "isAltarText": false
        },
        {
          "oldId": "liturgy-06714216a0de-1:b10848b54ed919ac:1",
          "chapterId": "liturgy-06714216a0de-1",
          "prefix": "По окончании последнего тропаря, диакон, став впереди священника в Царских вратах, возвышает св. Евангелие и, показывая его народу возглашает громогласно:",
          "rubricId": "liturgy-06714216a0de-1:76cea8210e7fb0d6:1",
          "prayerId": "liturgy-06714216a0de-1:25e501bb9f9276b1:1",
          "prayer": "Прему́дрость, про́сти.",
          "isAltarText": false
        },
        {
          "oldId": "liturgy-21d28bc25f3d-1:405d7b204081bc00:1",
          "chapterId": "liturgy-21d28bc25f3d-1",
          "prefix": "По окончании Трисвятого диакон, подойдя к Царским вратам, возглашает:",
          "rubricId": "liturgy-21d28bc25f3d-1:b9cc673f0712306b:1",
          "prayerId": "liturgy-21d28bc25f3d-1:3f9f154728d3fa4a:1",
          "prayer": "Во́нмем.",
          "isAltarText": false
        },
        {
          "oldId": "liturgy-e8e07c76cf8b-1:2f77e49339cfdc87:1",
          "chapterId": "liturgy-e8e07c76cf8b-1",
          "prefix": "И священник возглашает:",
          "rubricId": "liturgy-e8e07c76cf8b-1:d9746527e51c57a7:1",
          "prayerId": "liturgy-e8e07c76cf8b-1:2b3b40001b618625:1",
          "prayer": "Яко Ми́лостив и Человеколю́бец Бог еси́, и Тебе́ сла́ву возсыла́ем, Отцу́ и Сы́ну и Свято́му Ду́ху, ны́не и при́сно и во ве́ки веко́в.",
          "isAltarText": false
        },
        {
          "oldId": "liturgy-d66ea8339379-1:49fe2d58c581bf32:1",
          "chapterId": "liturgy-d66ea8339379-1",
          "prefix": "И священник возглашает:",
          "rubricId": "liturgy-d66ea8339379-1:d9746527e51c57a7:1",
          "prayerId": "liturgy-d66ea8339379-1:827647db05763297:1",
          "prayer": "Щедро́тами Единоро́днаго Сы́на Твоего́, с Ни́мже благослове́н еси́, со Пресвяты́м и Благи́м и Животворя́щим Твои́м Ду́хом, ны́не и при́сно, и во ве́ки веко́в.",
          "isAltarText": false
        },
        {
          "oldId": "liturgy-5d1f94f15d27-1:0bc39105b1999873:1",
          "chapterId": "liturgy-5d1f94f15d27-1",
          "prefix": "Священник возглашает, благословляя народ:",
          "rubricId": "liturgy-5d1f94f15d27-1:f36c7041a2ff7648:1",
          "prayerId": "liturgy-5d1f94f15d27-1:17671cda211766ad:1",
          "prayer": "Благода́ть Го́спода на́шего Иису́са Христа́, и любы́ Бо́га и Отца́, и прича́стие Свята́го Ду́ха, бу́ди со все́ми ва́ми.",
          "isAltarText": false
        },
        {
          "oldId": "liturgy-178e5055ac2b-1:00a89f4488a8e4fe:1",
          "chapterId": "liturgy-178e5055ac2b-1",
          "prefix": "И священник возглашает:",
          "rubricId": "liturgy-178e5055ac2b-1:d9746527e51c57a7:1",
          "prayerId": "liturgy-178e5055ac2b-1:9740e8717922cffa:1",
          "prayer": "Я́ко Твоя́ держа́ва, и Твое́ есть Ца́рство и си́ла и сла́ва, Отца́ и Сы́на и Свята́го Ду́ха, ны́не и при́сно и во ве́ки веко́в.",
          "isAltarText": false
        },
        {
          "oldId": "liturgy-178e5055ac2b-1:ac09dd84e8c5bf36:1",
          "chapterId": "liturgy-178e5055ac2b-1",
          "prefix": "Диакон возглашает:",
          "rubricId": "liturgy-178e5055ac2b-1:9e34ec9d32f53219:1",
          "prayerId": "liturgy-178e5055ac2b-1:3f9f154728d3fa4a:1",
          "prayer": "Во́нмем.",
          "isAltarText": false
        },
        {
          "oldId": "liturgy-178e5055ac2b-1:a779530bf587806c:1",
          "chapterId": "liturgy-178e5055ac2b-1",
          "prefix": "Священник же, вознося Святой Хлеб, возглашает:",
          "rubricId": "liturgy-178e5055ac2b-1:cd64e3d6e0344627:1",
          "prayerId": "liturgy-178e5055ac2b-1:5fb176622e57ec34:1",
          "prayer": "Свята́я святы́м.",
          "isAltarText": false
        },
        {
          "oldId": "liturgy-5b5535a3d8e6-1:7322e9e89c5b022c:1",
          "chapterId": "liturgy-5b5535a3d8e6-1",
          "prefix": "Лик же поет:",
          "rubricId": "liturgy-5b5535a3d8e6-1:3de8e82a751f09ef:1",
          "prayerId": "liturgy-5b5535a3d8e6-1:8ea1551f6e7f9703:1",
          "prayer": "Ви́дехом свет и́стинный, / прия́хом Ду́ха Небе́снаго, / обрето́хом ве́ру и́стинную, / неразде́льней Тро́ице покланя́емся, / Та бо нас спасла́ есть.",
          "isAltarText": false
        }
      ]
    },
