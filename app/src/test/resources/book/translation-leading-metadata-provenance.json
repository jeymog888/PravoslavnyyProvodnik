  "cases": [
    {
      "id": "prefix-0",
      "bookOriginal": "В будни: Прииди́те, поклони́мся и припаде́м ко Христу́. / Спаси́ ны, Сы́не Бо́жий, / во святы́х Ди́вен сый, пою́щия Ти, / Аллилу́иа. Единожды.",
      "prefix": "В будни:",
      "prayer": "Прииди́те, поклони́мся и припаде́м ко Христу́. / Спаси́ ны, Сы́не Бо́жий, / во святы́х Ди́вен сый, пою́щия Ти, / Аллилу́иа. Единожды.",
      "isAltarText": false,
      "previousKind": "PRAYER",
      "chapterId": "liturgy-06714216a0de-1",
      "sourceRows": [
        {
          "edition": "short",
          "sourceUrl": "https://azbyka.ru/bogosluzhenie/liturgiya-svt-ioanna-zlatousta/",
          "sourceHtmlSha256": "abb4dd9cfcc174194af1d1439840385308cba45e9e754fba5ca84b2a36fddf7f",
          "row": 54,
          "sourcePrefix": "",
          "paragraphBoundary": false,
          "russianSpeaker": "Хор",
          "russianPrefix": "",
