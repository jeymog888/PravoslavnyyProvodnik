	}
	function show_map_code() {
		var church =  jQuery("#box-filters #church_id").val();
		if (church>0) {
			var script_txt = '<!-- START MAP -->\n'+
				'<script type="text/javascript">\n'+
				'var mapDefaultFilter = {church_id:'+church+'}, setBoundsAuto=true, setHideChurchTree=true;\n'+
				'(function() {\n'+
				'var s = document.createElement("script");\n'+
				's.type ="text/javascript"; s.id = "map"; s.charset = "utf-8"; s.async = true;\n'+
				's.src = "//prihod.ru/map/js/init.js";\n'+
				'var sc = document.getElementsByTagName("head")[0];\n'+
				'if (sc){ sc.appendChild(s); }else{ document.documentElement.firstChild.appendChild(s); }\n'+
				'})();\n'+
				'</scr'+'ipt>\n'+
				'<main class="web-app-map" id="web-app-map" style="width:100%;height:600px"></main>\n'+
				'<!-- END MAP -->\n';
		} else {
			var script_txt='Выберите в фильтре вашу епархию';
		}
		jQuery("#btnShowCode").hide();
		jQuery("#btnHideCode").show();
		jQuery("#map-code").show();
		jQuery("#map-code").text(script_txt);
		jQuery("#map-code").focus();

	}
</script>
</body>
</html>